# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# DynamoDB Configuration
BUGS_TABLE=JiraQABugsTable
# Optional local endpoint for DynamoDB Local / LocalStack (e.g., http://localhost:8000)
# DYNAMODB_ENDPOINT=http://localhost:8000

# S3 Configuration
ATTACHMENTS_BUCKET=jira-qa-bug-attachments
# Optional local endpoint for MinIO / LocalStack (e.g., http://localhost:9000)
# S3_ENDPOINT=http://localhost:9000

# Local Server Port
PORT=5000
